natura” e “Tarefas automáticas”." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1110" y="660" width="280" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f-compra" name="5. Fluxo — Compra na vitrine"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f-compra-v1" value="&lt;b&gt;Fluxo — Compra na vitrine&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="f-compra-v2" value="Do link da loja até o pedido aparecer no painel do lojista." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="24" as="geometry"/></mxCell><mxCell id="f-compra-v3" value="Cliente (navegador)" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="2500" height="270" as="geometry"/></mxCell><mxCell id="f-compra-v4" value="Vitrio (frontend + API)" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="370" width="2500" height="380" as="geometry"/></mxCell><mxCell id="f-compra-v5" value="Lojista" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="750" width="2500" height="190" as="geometry"/></mxCell><mxCell id="f-compra-v6" value="Abre o link da loja&lt;br&gt;/store/{slug}" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="f-compra-v3"><mxGeometry x="55" y="62" width="190" height="56" as="geometry"/></mxCell><mxCell id="f-compra-v7" value="Loja no ar?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-compra-v4"><mxGeometry x="75" y="55" width="150" height="90" as="geometry"/></mxCell><mxCell id="f-compra-v8" value="Mostra “loja&lt;br&gt;indisponível”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="f-compra-v4"><mxGeometry x="65" y="247" width="170" height="66" as="geometry"/></mxCell><mxCell id="f-compra-v9" value="Carrega categorias e só os&lt;br&gt;produtos visíveis (ativos e&lt;br&gt;dentro do limite do plano)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-compra-v4"><mxGeometry x="290" y="62" width="220" height="76" as="geometry"/></mxCell><mxCell id="f-compra-v10" value="Navega, filtra por&lt;br&gt;categoria e abre&lt;br&gt;um produto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-compra-v3"><mxGeometry x="295" y="57" width="210" height="66" as="geometry"/></mxCell><mxCell id="f-compra-v11" value="Escolhe tamanho e cor&lt;br&gt;e adiciona ao carrinho&lt;br&gt;(salvo no navegador)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-compra-v3"><mxGeometry x="545" y="57" width="210" height="66" as="geometry"/></mxCell><mxCell id="f-compra-v12" value="Finaliza: nome, telefone&lt;br&gt;e endereço de entrega" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-compra-v3"><mxGeometry x="795" y="57" width="210" height="66" as="geometry"/></mxCell><mxCell id="f-compra-v13" value="Está logado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-compra-v3"><mxGeometry x="1070" y="45" width="140" height="90" as="geometry"/></mxCell><mxCell id="f-compra-v14" value="Pode usar um endereço&lt;br&gt;salvo e salvar o novo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-compra-v3"><mxGeometry x="1040" y="187" width="200" height="56" as="geometry"/></mxCell><mxCell id="f-compra-v15" value="Digita o endereço" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-compra-v3"><mxGeometry x="1295" y="62" width="170" height="56" as="geometry"/></mxCell><mxCell id="f-compra-v16" value="Dados válidos?&lt;br&gt;(nome, telefone&lt;br&gt;com DDD, CEP, itens)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-compra-v4"><mxGeometry x="1290" y="45" width="180" height="110" as="geometry"/></mxCell><mxCell id="f-compra-v17" value="Mostra o erro&lt;br&gt;para corrigir" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="f-compra-v4"><mxGeometry x="1295" y="262" width="170" height="56" as="geometry"/></mxCell><mxCell id="f-compra-v18" value="Abre uma transação e&lt;br&gt;recalcula os preços pelo banco&lt;br&gt;(nunca pelo navegador)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-compra-v4"><mxGeometry x="1520" y="62" width="220" height="76" as="geometry"/></mxCell><mxCell id="f-compra-v19" value="Tem estoque de&lt;br&gt;todos os itens?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-compra-v4"><mxGeometry x="1800" y="50" width="160" height="100" as="geometry"/></mxCell><mxCell id="f-compra-v20" value="Desfaz tudo e avisa&lt;br&gt;“estoque insuficiente”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="f-compra-v4"><mxGeometry x="1785" y="262" width="190" height="56" as="geometry"/></mxCell><mxCell id="f-compra-v21" value="Baixa o estoque (atômico) e&lt;br&gt;cria o pedido &lt;b&gt;Pendente&lt;/b&gt;&lt;br&gt;com um código" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-compra-v4"><mxGeometry x="2020" y="62" width="220" height="76" as="geometry"/></mxCell><mxCell id="f-compra-v22" value="&lt;b&gt;Pagar agora&lt;/b&gt;: o pedido nasce “Aguardando pagamento” e só chega ao lojista depois de pago (ver página 13)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="2170" y="600" width="250" height="80" as="geometry"/></mxCell><mxCell id="f-compra-v23" value="Vê o código do pedido e o&lt;br&gt;botão para falar com a&lt;br&gt;loja no WhatsApp" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="f-compra-v3"><mxGeometry x="2020" y="52" width="220" height="76" as="geometry"/></mxCell><mxCell id="f-compra-v24" value="Avisa o lojista: no painel&lt;br&gt;(a cada 30s) e por e-mail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-compra-v5"><mxGeometry x="2020" y="65" width="220" height="60" as="geometry"/></mxCell><mxCell id="f-compra-v25" value="Confirma, envia e entrega&lt;br&gt;(ver “Fluxo — Pedidos&lt;br&gt;no painel”)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="f-compra-v5"><mxGeometry x="2285" y="60" width="190" height="70" as="geometry"/></mxCell><mxCell id="f-compra-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-compra-v6" target="f-compra-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-compra-e27" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-compra-v7" target="f-compra-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-compra-e28" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-compra-v7" target="f-compra-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-compra-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-compra-v9" target="f-compra-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-compra-e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source=