 parent="1" source="f-compra-v18" target="f-compra-v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-compra-e41" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-compra-v19" target="f-compra-v20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-compra-e42" value="o carrinho se acerta&lt;br&gt;com a loja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-compra-v20" target="f-compra-v11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1900" y="725"/><mxPoint x="670" y="725"/></Array></mxGeometry></mxCell><mxCell id="f-compra-e43" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-compra-v19" target="f-compra-v21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-compra-e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-compra-v21" target="f-compra-v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-compra-e45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-compra-v21" target="f-compra-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-compra-e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-compra-v24" target="f-compra-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-compra-v47" value="&lt;b&gt;Carrinho salvo&lt;/b&gt;: ao abrir a loja, ele é acertado com o catálogo (sai o que esgotou ou saiu da vitrine; preço e quantidade atualizados) e um aviso mostra o que mudou." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="685" y="245" width="220" height="104" as="geometry"/></mxCell><mxCell id="f-compra-v48" value="&lt;b&gt;Loja no ar&lt;/b&gt; = ativa, não excluída e dentro do número de lojas do plano do lojista." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="280" y="560" width="230" height="76" as="geometry"/></mxCell><mxCell id="f-compra-v49" value="&lt;b&gt;Ordem&lt;/b&gt;: destaques, depois os mais novos. Os &lt;b&gt;esgotados vão para o fim&lt;/b&gt;, e o card de uma peça com várias cores abre numa cor que tem estoque." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="440" y="240" width="210" height="96" as="geometry"/></mxCell><mxCell id="f-compra-v50" value="O pedido guarda uma cópia do nome, preço e foto de cada item e do endereço. Se o cliente estiver logado, fica ligado à conta e aparece em “Meus pedidos”.&lt;br&gt;Limite: 10 pedidos por minuto por IP." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="2290" y="395" width="220" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f-pedidos" name="6. Fluxo — Pedidos no painel"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f-pedidos-v1" value="&lt;b&gt;Fluxo — Pedidos no painel&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="f-pedidos-v2" value="Os estados de um pedido e o alerta de pedido novo." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="24" as="geometry"/></mxCell><mxCell id="f-pedidos-v3" value="&lt;b&gt;Estados do pedido (OrderStatus)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="84" width="400" height="28" as="geometry"/></mxCell><mxCell id="f-pedidos-v4" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="66" y="248" width="28" height="28" as="geometry"/></mxCell><mxCell id="f-pedidos-v5" value="Pendente" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="234" width="160" height="56" as="geometry"/></mxCell><mxCell id="f-pedidos-v6" value="Aguardando&lt;br&gt;pagamento" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="180" y="124" width="160" height="56" as="geometry"/></mxCell><mxCell id="f-pedidos-v7" value="Confirmado" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="480" y="234" width="160" height="56" as="geometry"/></mxCell><mxCell id="f-pedidos-v8" value="Enviado" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="780" y="234" width="160" height="56" as="geometry"/></mxCell><mxCell id="f-pedidos-v9" value="Entregue" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1080" y="234" width="160" height="56" as="geometry"/></mxCell><mxCell id="f-pedidos-v10" value="Cancelado" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="630" y="452" width="160" height="56" as="geometry"/></mxCell><mxCell id="f-pedidos-v11" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="1346" y="246" width="32" height="32" as="geometry"/></mxCell><mxCell id="f-pedidos-v12" value="" style="ellipse;shape=doubleEllipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="694" y="584" width="32" height="32" as="geometry"/></mxCell><mxCell id="f-pedidos-e13" value="combinar com&lt;br&gt;a loja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f-pedidos-v4" target="f-pedidos-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-e14" value="pagar agora" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pedidos-v4" target="f-pedidos-v6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="80" y="152"/></Array></mxGeometry></mxCell><mxCell id="f-pedidos-e15" value="pagamento aprovado&lt;br&gt;(o lojista é avisado)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pedidos-v6" target="f-pedidos-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-e16" value="prazo vencido, loja ou cliente cancela&lt;br&gt;(estoque volta; se pagar depois, estorna)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0.2;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pedidos-v6" target="f-pedidos-v10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="166"/><mxPoint x="30" y="545"/><mxPoint x="662" y="545"/></Array></mxGeometry></mxCell><mxCell id="f-pedidos-e17" value="lojista&lt;br&gt;confirma" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f-pedidos-v5" target="f-pedidos-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-e18" value="lojista&lt;br&gt;envia" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f-pedidos-v7" target="f-pedidos-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-e19" value="entregue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f-pedidos-v8" target="f-pedidos-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-e20" value="entregue direto (retirada ou entrega local)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pedidos-v7" target="f-pedidos-v9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="180"/><mxPoint x="1160" y="180"/></Array></mxGeometry></mxCell><mxCell id="f-pedidos-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f-pedidos-v9" target="f-pedidos-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-e22" value="cancelar&lt;br&gt;(pago online: estorna)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pedidos-v5" target="f-pedidos-v10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="260" y="480"/></Array></mxGeometry></mxCell><mxCell id="f-pedidos-e23" value="cancelar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pedidos-v7" target="f-pedidos-v10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="400"/><mxPoint x="670" y="400"/></Array></mxGeometry></mxCell><mxCell id="f-pedidos-e24" value="cancelar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pedidos-v8" target="f-pedidos-v10"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="860" y="400"/><mxPoint x="750" y="400"/></Array></mxGeometry></mxCell><mxCell id="f-pedidos-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=open;endSize=10;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f-pedidos-v10" target="f-pedidos-v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-v26" value="&lt;b&gt;Ao criar&lt;/b&gt;: o estoque é reservado na hora.&lt;br&gt;&lt;b&gt;Ao cancelar&lt;/b&gt;: o estoque reservado volta para o produto (ou para o tamanho).&lt;br&gt;&lt;b&gt;Entregue e Cancelado são finais&lt;/b&gt;: não mudam mais (a API recusa voltar ou pular status)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="330" height="90" as="geometry"/></mxCell><mxCell id="f-pedidos-v27" value="&lt;b&gt;Pago online&lt;/b&gt;: cancelar estorna no Mercado Pago. Se a conta da loja não alcança mais o pagamento (desconectada ou acesso revogado), o pedido é cancelado e o lojista devolve o valor pelo app do Mercado Pago." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="420" y="640" width="330" height="90" as="geometry"/></mxCell><mxCell id="f-pedidos-v28" value="Em qualquer estado, o lojista pode chamar o cliente pelo WhatsApp a partir do pedido." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1000" y="640" width="300" height="50" as="geometry"/></mxCell><mxCell id="f-pedidos-v29" value="&lt;b&gt;Alerta de pedido novo (useOrderAlerts)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="400" height="28" as="geometry"/></mxCell><mxCell id="f-pedidos-v30" value="&lt;b&gt;E-mail&lt;/b&gt;: além do painel, o dono recebe um e-mail a cada pedido novo (pago online: quando o pagamento é aprovado). Dá para desligar em Configurações da loja." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1420" y="840" width="300" height="90" as="geometry"/></mxCell><mxCell id="f-pedidos-v31" value="Lojista com o painel&lt;br&gt;da loja aberto" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="65" y="852" width="190" height="56" as="geometry"/></mxCell><mxCell id="f-pedidos-v32" value="A cada 30s e ao voltar para a aba:&lt;br&gt;GET /pending-summary" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="847" width="240" height="66" as="geometry"/></mxCell><mxCell id="f-pedidos-v33" value="O id do pendente&lt;br&gt;mais recente&lt;br&gt;aumentou?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="645" y="825" width="170" height="110" as="geometry"/></mxCell><mxCell id="f-pedidos-v34" value="Mostra um aviso discreto&lt;br&gt;com o pedido novo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="895" y="847" width="210" height="66" as="geometry"/></mxCell><mxCell id="f-pedidos-v35" value="Atualiza o número de&lt;br&gt;pendentes na barra lateral" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1175" y="847" width="210" height="66" as="geometry"/></mxCell><mxCell id="f-pedidos-e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-pedidos-v31" target="f-pedidos-v32"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-e37" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-pedidos-v32" target="f-pedidos-v33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-e38" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-pedidos-v33" target="f-pedidos-v34"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-e39" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-pedidos-v34" target="f-pedidos-v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pedidos-e40" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pedidos-v33" target="f-pedidos-v35"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="730" y="990"/><mxPoint x="1280" y="990"/></Array></mxGeometry></mxCell><mxCell id="f-pedidos-e41" value="espera 30s" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pedidos-v35" target="f-pedidos-v32"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1280" y="810"/><mxPoint x="440" y="810"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="f-login" name="7. Fluxo — Cadastro, login e sessão"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f-login-v1" value="&lt;b&gt;Fluxo — Cadastro, login e sessão&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="f-login-v2" value="Como a conta é criada, como o login funciona e como a sessão se renova sozinha." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="24" as="geometry"/></mxCell><mxCell id="f-login-v3" value="Lojista abre /auth/register" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325" y="102" width="190" height="56" as="geometry"/></mxCell><mxCell id="f-login-v4" value="Preenche nome, e-mail, CPF&lt;br&gt;e senha (mín. 8 caracteres)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="315" y="207" width="210" height="66" as="geometry"/></mxCell><mxCell id="f-login-v5" value="Dados válidos e&lt;br&gt;e-mail e CPF livres?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="315" width="190" height="110" as="geometry"/></mxCell><mxCell id="f-login-v6" value="Mostra o erro" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="342" width="170" height="56" as="geometry"/></mxCell><mxCell id="f-login-v7" value="Cria a conta com o papel&lt;br&gt;Lojista e vai para o login" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="315" y="467" width="210" height="66" as="geometry"/></mxCell><mxCell id="f-login-v8" value="Entra em /auth/login&lt;br&gt;com CPF ou e-mail e senha" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="315" y="577" width="210" height="66" as="geometry"/></mxCell><mxCell id="f-login-v9" value="Senha certa?&lt;br&gt;(até 10 tentativas&lt;br&gt;por minuto por IP)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="685" width="190" height="120" as="geometry"/></mxCell><mxCell id="f-login-v10" value="“CPF/e-mail ou&lt;br&gt;senha inválidos”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="675" y="715" width="170" height="60" as="geometry"/></mxCell><mxCell id="f-login-v11" value="Recebe o access token (15 min,&lt;br&gt;fica só na memória) e o refresh&lt;br&gt;token (7 dias, cookie HttpOnly)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="295" y="845" width="250" height="80" as="geometry"/></mxCell><mxCell id="f-login-v12" value="Usa o sistema: cada requisição&lt;br&gt;leva o access token" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="977" width="240" height="66" as="geometry"/></mxCell><mxCell id="f-login-v13" value="A API respondeu&lt;br&gt;401 (token vencido)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="325" y="1085" width="190" height="110" as="geometry"/></mxCell><mxCell id="f-login-v14" value="O frontend chama /api/Auth/refresh&lt;br&gt;(uma vez só, mesmo com várias&lt;br&gt;requisições ao mesmo tempo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="1242" width="260" height="76" as="geometry"/></mxCell><mxCell id="f-login-v15" value="Refresh válido?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="335" y="1365" width="170" height="90" as="geometry"/></mxCell><mxCell id="f-login-v16" value="Recebe um access token novo,&lt;br&gt;troca o refresh token e&lt;br&gt;repete a requisição" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="645" y="1372" width="230" height="76" as="geometry"/></mxCell><mxCell id="f-login-v17" value="Volta para o login&lt;br&gt;(na vitrine, só sai da conta)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="305" y="1510" width="230" height="60" as="geometry"/></mxCell><mxCell id="f-login-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v3" target="f-login-v4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v4" target="f-login-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e20" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v5" target="f-login-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-login-v6" target="f-login-v4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="240"/></Array></mxGeometry></mxCell><mxCell id="f-login-e22" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v5" target="f-login-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v7" target="f-login-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v8" target="f-login-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e25" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v9" target="f-login-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-login-v10" target="f-login-v8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="610"/></Array></mxGeometry></mxCell><mxCell id="f-login-e27" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v9" target="f-login-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v11" target="f-login-v12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v12" target="f-login-v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e30" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-login-v13" target="f-login-v12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="230" y="1140"/><mxPoint x="230" y="1010"/></Array></mxGeometry></mxCell><mxCell id="f-login-e31" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v13" target="f-login-v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v14" target="f-login-v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e33" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v15" target="f-login-v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-login-v16" target="f-login-v12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="760" y="1010"/></Array></mxGeometry></mxCell><mxCell id="f-login-e35" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-login-v15" target="f-login-v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-login-v36" value="&lt;b&gt;Cliente da vitrine&lt;/b&gt;: cria a conta no modal da loja (nome, e-mail, senha e telefone opcional) e entra com e-mail. A sessão funciona do mesmo jeito." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="960" y="210" width="280" height="96" as="geometry"/></mxCell><mxCell id="f-login-v37" value="&lt;b&gt;Senhas&lt;/b&gt; ficam com o PasswordHasher do ASP.NET. Senhas antigas (HMACSHA512) ainda são aceitas e são regravadas no formato novo no próximo login." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="960" y="700" width="280" height="96" as="geometry"/></mxCell><mxCell id="f-login-v38" value="&lt;b&gt;Sair&lt;/b&gt; revoga o refresh token.&lt;br&gt;&lt;b&gt;Trocar a senha&lt;/b&gt; ou &lt;b&gt;redefinir pelo e-mail&lt;/b&gt; encerra todas as sessões.&lt;br&gt;No banco, o refresh token fica só como hash SHA-256." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="960" y="1360" width="280" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f-senha" name="8. Fluxo — Esqueci minha senha"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f-senha-v1" value="&lt;b&gt;Fluxo — Esqueci minha senha&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="f-senha-v2" value="Pedido do link, envio pelo Resend e troca da senha." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="24" as="geometry"/></mxCell><mxCell id="f-senha-v3" value="Usuário" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1780" height="250" as="geometry"/></mxCell><mxCell id="f-senha-v4" value="Vitrio (API)" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="1780" height="380" as="geometry"/></mxCell><mxCell id="f-senha-v5" value="Resend (e-mail)" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="1780" height="170" as="geometry"/></mxCell><mxCell id="f-senha-v6" value="Clica em “Esqueci minha&lt;br&gt;senha” e informa o e-mail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="f-senha-v3"><mxGeometry x="50" y="68" width="200" height="64" as="geometry"/></mxCell><mxCell id="f-senha-v7" value="A conta existe e não&lt;br&gt;pediu um link nos&lt;br&gt;últimos 2 min?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-senha-v4"><mxGeometry x="55" y="60" width="190" height="120" as="geometry"/></mxCell><mxCell id="f-senha-v8" value="Não envia nada" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="f-senha-v4"><mxGeometry x="65" y="285" width="170" height="50" as="geometry"/></mxCell><mxCell id="f-senha-v9" value="Apaga os links antigos e cria&lt;br&gt;um token novo (30 min, uso&lt;br&gt;único; salva só o hash)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-senha-v4"><mxGeometry x="305" y="80" width="230" height="80" as="geometry"/></mxCell><mxCell id="f-senha-v10" value="Coloca o e-mail na fila&lt;br&gt;(a resposta não espera&lt;br&gt;o envio)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-senha-v4"><mxGeometry x="595" y="82" width="210" height="76" as="geometry"/></mxCell><mxCell id="f-senha-v11" value="Envia o e-mail com o link&lt;br&gt;/auth/reset-password?token=…" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="f-senha-v5"><mxGeometry x="575" y="53" width="250" height="64" as="geometry"/></mxCell><mxCell id="f-senha-v12" value="Abre o link do e-mail" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-senha-v3"><mxGeometry x="885" y="72" width="190" height="56" as="geometry"/></mxCell><mxCell id="f-senha-v13" value="Digita a nova senha&lt;br&gt;(mín. 8 caracteres)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-senha-v3"><mxGeometry x="1130" y="70" width="200" height="60" as="geometry"/></mxCell><mxCell id="f-senha-v14" value="O token existe&lt;br&gt;e não venceu?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-senha-v4"><mxGeometry x="1145" y="70" width="170" height="100" as="geometry"/></mxCell><mxCell id="f-senha-v15" value="“Link inválido ou vencido”:&lt;br&gt;pede um link novo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="f-senha-v4"><mxGeometry x="1120" y="270" width="220" height="60" as="geometry"/></mxCell><mxCell id="f-senha-v16" value="Grava a nova senha, apaga&lt;br&gt;o token e encerra todas&lt;br&gt;as sessões" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-senha-v4"><mxGeometry x="1400" y="82" width="220" height="76" as="geometry"/></mxCell><mxCell id="f-senha-v17" value="Entra com a nova senha" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="f-senha-v3"><mxGeometry x="1405" y="72" width="210" height="56" as="geometry"/></mxCell><mxCell id="f-senha-e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-senha-v6" target="f-senha-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-senha-e19" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-senha-v7" target="f-senha-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-senha-e20" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-senha-v7" target="f-senha-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-senha-e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-senha-v9" target="f-senha-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-senha-e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-senha-v10" target="f-senha-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-senha-e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-senha-v11" target="f-senha-v12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="815"/></Array></mxGeometry></mxCell><mxCell id="f-senha-e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-senha-v12" target="f-senha-v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-senha-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-senha-v13" target="f-senha-v14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-senha-e26" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-senha-v14" target="f-senha-v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-senha-e27" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-senha-v14" target="f-senha-v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-senha-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-senha-v16" target="f-senha-v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-senha-v29" value="A tela sempre mostra a mesma mensagem, exista a conta ou não: ninguém descobre quais e-mails estão cadastrados." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="300" y="140" width="300" height="76" as="geometry"/></mxCell><mxCell id="f-senha-v30" value="Sem a chave do Resend, em desenvolvimento o e-mail com o link aparece no log da API." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1020" y="775" width="260" height="70" as="geometry"/></mxCell><mxCell id="f-senha-v31" value="Os dois endpoints têm limite de 10 por minuto por IP. Links vencidos são apagados pela limpeza a cada 6h." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1450" y="600" width="300" height="76" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="f-lojas" name="9. Fluxo — Lojas, produtos e limites do plano"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f-lojas-v1" value="&lt;b&gt;Fluxo — Lojas, produtos e limites do plano&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="f-lojas-v2" value="Criar loja, cadastrar produto e o que acontece quando o plano diminui." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="24" as="geometry"/></mxCell><mxCell id="f-lojas-v3" value="&lt;b&gt;Criar loja&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="150" y="100" width="400" height="28" as="geometry"/></mxCell><mxCell id="f-lojas-v4" value="Clica em “Criar loja”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="155" y="142" width="190" height="56" as="geometry"/></mxCell><mxCell id="f-lojas-v5" value="Já tem o máximo de&lt;br&gt;lojas do plano?&lt;br&gt;(excluídas não contam)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="150" y="240" width="200" height="120" as="geometry"/></mxCell><mxCell id="f-lojas-v6" value="Recusa: “veja os planos&lt;br&gt;em Assinatura”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="270" width="200" height="60" as="geometry"/></mxCell><mxCell id="f-lojas-v7" value="Preenche nome, CNPJ (opcional),&lt;br&gt;descrição, telefone, cores e logo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="125" y="407" width="250" height="66" as="geometry"/></mxCell><mxCell id="f-lojas-v8" value="Nome repetido nas suas&lt;br&gt;lojas ou CNPJ inválido&lt;br&gt;ou já usado?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="145" y="520" width="210" height="120" as="geometry"/></mxCell><mxCell id="f-lojas-v9" value="Mostra o erro" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="445" y="552" width="170" height="56" as="geometry"/></mxCell><mxCell id="f-lojas-v10" value="Cria a loja com um link único&lt;br&gt;(/store/nome-da-loja)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="135" y="690" width="230" height="60" as="geometry"/></mxCell><mxCell id="f-lojas-v11" value="Abre o painel da loja" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="145" y="802" width="210" height="56" as="geometry"/></mxCell><mxCell id="f-lojas-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v4" target="f-lojas-v5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e13" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v5" target="f-lojas-v6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e14" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v5" target="f-lojas-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v7" target="f-lojas-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e16" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v8" target="f-lojas-v9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-lojas-v9" target="f-lojas-v7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="530" y="440"/></Array></mxGeometry></mxCell><mxCell id="f-lojas-e18" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v8" target="f-lojas-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v10" target="f-lojas-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-v20" value="&lt;b&gt;Cadastrar produto&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="790" y="100" width="400" height="28" as="geometry"/></mxCell><mxCell id="f-lojas-v21" value="No painel, abre Produtos&lt;br&gt;e clica em “Novo produto”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="770" y="140" width="220" height="60" as="geometry"/></mxCell><mxCell id="f-lojas-v22" value="Preenche nome, preço, estoque,&lt;br&gt;categoria, tamanhos e cor" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="760" y="267" width="240" height="66" as="geometry"/></mxCell><mxCell id="f-lojas-v23" value="Envia as fotos: o frontend confere o&lt;br&gt;login e sobe no Cloudinary&lt;br&gt;(JPG, PNG ou WEBP até 5 MB)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="750" y="402" width="260" height="76" as="geometry"/></mxCell><mxCell id="f-lojas-v24" value="Ativo, passaria do&lt;br&gt;limite de produtos&lt;br&gt;do plano?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="785" y="520" width="190" height="120" as="geometry"/></mxCell><mxCell id="f-lojas-v25" value="Recusa: limite&lt;br&gt;do plano" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1050" y="550" width="160" height="60" as="geometry"/></mxCell><mxCell id="f-lojas-v26" value="Salva e o produto&lt;br&gt;aparece na vitrine" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="775" y="690" width="210" height="60" as="geometry"/></mxCell><mxCell id="f-lojas-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v21" target="f-lojas-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v22" target="f-lojas-v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v23" target="f-lojas-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e30" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v24" target="f-lojas-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e31" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v24" target="f-lojas-v26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-v32" value="&lt;b&gt;Editar&lt;/b&gt;: o estoque salvo é o atual mais a diferença digitada. Uma venda feita com o formulário aberto continua descontada." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1000" y="690" width="250" height="90" as="geometry"/></mxCell><mxCell id="f-lojas-v33" value="&lt;b&gt;Quando o plano diminui&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1400" y="100" width="400" height="28" as="geometry"/></mxCell><mxCell id="f-lojas-v34" value="O plano muda para um menor&lt;br&gt;(cancelou, atrasou ou fez downgrade)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="140" width="260" height="60" as="geometry"/></mxCell><mxCell id="f-lojas-v35" value="Nada é apagado: os limites&lt;br&gt;são calculados na hora" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1405" y="260" width="230" height="60" as="geometry"/></mxCell><mxCell id="f-lojas-v36" value="Ficam na vitrine as lojas e os&lt;br&gt;produtos ativos &lt;b&gt;mais antigos&lt;/b&gt;,&lt;br&gt;até o limite do plano" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1395" y="372" width="250" height="76" as="geometry"/></mxCell><mxCell id="f-lojas-v37" value="O resto sai da vitrine e não aceita&lt;br&gt;pedidos (o painel mostra “Fora do&lt;br&gt;ar” e “Oculto pelo plano”)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1390" y="502" width="260" height="76" as="geometry"/></mxCell><mxCell id="f-lojas-v38" value="O lojista quer&lt;br&gt;escolher outra loja&lt;br&gt;ou produto?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1425" y="620" width="190" height="120" as="geometry"/></mxCell><mxCell id="f-lojas-v39" value="“Deixar esta loja no ar” pausa as&lt;br&gt;que passarem do limite; desativar&lt;br&gt;um produto libera uma vaga" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1715" y="642" width="250" height="76" as="geometry"/></mxCell><mxCell id="f-lojas-v40" value="Se assinar de novo,&lt;br&gt;tudo volta sozinho" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1415" y="800" width="210" height="60" as="geometry"/></mxCell><mxCell id="f-lojas-e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v34" target="f-lojas-v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v35" target="f-lojas-v36"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v36" target="f-lojas-v37"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v37" target="f-lojas-v38"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e45" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v38" target="f-lojas-v39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-lojas-v39" target="f-lojas-v36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1840" y="410"/></Array></mxGeometry></mxCell><mxCell id="f-lojas-e47" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v38" target="f-lojas-v40"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-v48" value="&lt;b&gt;Excluir loja&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="2140" y="100" width="400" height="28" as="geometry"/></mxCell><mxCell id="f-lojas-v49" value="Digita o nome da loja e&lt;br&gt;clica em “Excluir”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2150" y="140" width="220" height="60" as="geometry"/></mxCell><mxCell id="f-lojas-v50" value="Tem pedidos em&lt;br&gt;andamento?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="2175" y="250" width="170" height="100" as="geometry"/></mxCell><mxCell id="f-lojas-v51" value="Recusa: concluir ou cancelar&lt;br&gt;antes (ou pausar a loja)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2425" y="270" width="230" height="60" as="geometry"/></mxCell><mxCell id="f-lojas-v52" value="Exclusão lógica: some do painel&lt;br&gt;e da vitrine; apaga a conta do&lt;br&gt;Mercado Pago conectada" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2135" y="402" width="250" height="76" as="geometry"/></mxCell><mxCell id="f-lojas-v53" value="Loja excluída" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="2165" y="532" width="190" height="56" as="geometry"/></mxCell><mxCell id="f-lojas-e54" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v49" target="f-lojas-v50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e55" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v50" target="f-lojas-v51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e56" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v50" target="f-lojas-v52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-lojas-e57" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-lojas-v52" target="f-lojas-v53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="f-assinatura" name="10. Fluxo — Assinatura com Mercado Pago"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0" background="#ffffff"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="f-assinatura-v1" value="&lt;b&gt;Fluxo — Assinatura com Mercado Pago&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;whiteSpace=wrap;fontColor=#1a1a1a;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1400" height="34" as="geometry"/></mxCell><mxCell id="f-assinatura-v2" value="Do clique em um plano até o plano novo valer. Embaixo: renovação, atraso e cancelamento." style="text;html=1;align=left;verticalAlign=middle;fontSize=13;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="24" as="geometry"/></mxCell><mxCell id="f-assinatura-v3" value="Lojista (navegador)" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="2420" height="250" as="geometry"/></mxCell><mxCell id="f-assinatura-v4" value="Vitrio (API)" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="350" width="2420" height="560" as="geometry"/></mxCell><mxCell id="f-assinatura-v5" value="Mercado Pago" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="910" width="2420" height="230" as="geometry"/></mxCell><mxCell id="f-assinatura-v6" value="Abre “Assinatura” e&lt;br&gt;escolhe um plano" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="f-assinatura-v3"><mxGeometry x="55" y="92" width="190" height="56" as="geometry"/></mxCell><mxCell id="f-assinatura-v7" value="O que o backend&lt;br&gt;permite?&lt;br&gt;(DecideAction)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="60" y="90" width="180" height="120" as="geometry"/></mxCell><mxCell id="f-assinatura-v8" value="Plano menor: muda o valor da&lt;br&gt;próxima cobrança no Mercado&lt;br&gt;Pago e agenda o plano" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="35" y="292" width="230" height="76" as="geometry"/></mxCell><mxCell id="f-assinatura-v9" value="O plano menor começa&lt;br&gt;no próximo ciclo" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="45" y="450" width="210" height="60" as="geometry"/></mxCell><mxCell id="f-assinatura-v10" value="Descarta o checkout aberto&lt;br&gt;anterior e cria a assinatura&lt;br&gt;(preapproval)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="320" y="112" width="220" height="76" as="geometry"/></mxCell><mxCell id="f-assinatura-v11" value="Cria a preapproval e&lt;br&gt;devolve o link de&lt;br&gt;pagamento (init_point)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="f-assinatura-v5"><mxGeometry x="320" y="77" width="220" height="76" as="geometry"/></mxCell><mxCell id="f-assinatura-v12" value="Guarda o plano como pendente&lt;br&gt;(PendingSince); o navegador&lt;br&gt;lembra o plano por 2h" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="595" y="112" width="230" height="76" as="geometry"/></mxCell><mxCell id="f-assinatura-v13" value="É levado para o checkout&lt;br&gt;do Mercado Pago" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-assinatura-v3"><mxGeometry x="600" y="90" width="220" height="60" as="geometry"/></mxCell><mxCell id="f-assinatura-v14" value="Paga no checkout&lt;br&gt;(no sandbox: com o&lt;br&gt;comprador de teste)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="f-assinatura-v5"><mxGeometry x="880" y="77" width="200" height="76" as="geometry"/></mxCell><mxCell id="f-assinatura-v15" value="Redireciona para o back_url&lt;br&gt;/api/Subscription/return" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="f-assinatura-v5"><mxGeometry x="1135" y="83" width="230" height="64" as="geometry"/></mxCell><mxCell id="f-assinatura-v16" value="Redireciona o navegador&lt;br&gt;para /menu/subscription" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="1140" y="300" width="220" height="60" as="geometry"/></mxCell><mxCell id="f-assinatura-v17" value="Mostra “Confirmando seu pagamento”&lt;br&gt;e confere a cada 5s no 1º minuto,&lt;br&gt;depois a cada 30s" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-assinatura-v3"><mxGeometry x="1115" y="82" width="270" height="76" as="geometry"/></mxCell><mxCell id="f-assinatura-v18" value="Envia o webhook&lt;br&gt;(subscription_preapproval)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="f-assinatura-v5"><mxGeometry x="1430" y="83" width="220" height="64" as="geometry"/></mxCell><mxCell id="f-assinatura-v19" value="Valida a assinatura (x-signature)&lt;br&gt;e registra o aviso (o mesmo aviso&lt;br&gt;não é processado duas vezes)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="1415" y="292" width="250" height="76" as="geometry"/></mxCell><mxCell id="f-assinatura-v20" value="Pago no&lt;br&gt;Mercado Pago?&lt;br&gt;(status authorized)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="1735" y="90" width="190" height="120" as="geometry"/></mxCell><mxCell id="f-assinatura-v21" value="O plano novo vale agora; define&lt;br&gt;o fim do período; no upgrade,&lt;br&gt;cancela a assinatura antiga" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="2035" y="112" width="250" height="76" as="geometry"/></mxCell><mxCell id="f-assinatura-v22" value="Vê “Pagamento confirmado”&lt;br&gt;(em qualquer aba aberta)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="f-assinatura-v3"><mxGeometry x="2040" y="88" width="240" height="64" as="geometry"/></mxCell><mxCell id="f-assinatura-v23" value="Cancelado no&lt;br&gt;Mercado Pago?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="1745" y="290" width="170" height="100" as="geometry"/></mxCell><mxCell id="f-assinatura-v24" value="Descarta o pendente: o plano&lt;br&gt;não muda (a página avisa)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="2040" y="308" width="240" height="64" as="geometry"/></mxCell><mxCell id="f-assinatura-v25" value="Continua esperando; com 2 dias&lt;br&gt;sem pagar, cancela e descarta" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="f-assinatura-v4"><mxGeometry x="1710" y="465" width="240" height="60" as="geometry"/></mxCell><mxCell id="f-assinatura-e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-assinatura-v6" target="f-assinatura-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-e27" value="plano menor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-assinatura-v7" target="f-assinatura-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" ed