0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="720" width="280" height="98" as="geometry"/></mxCell><mxCell id="classes-v34" value="Client = 0 · cliente da vitrine&lt;br&gt;Admin = 1&lt;br&gt;Shopkeeper = 2 · lojista" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="classes-cls33"><mxGeometry x="0" y="44" width="280" height="54" as="geometry"/></mxCell><mxCell id="classes-cls35" value="«enumeração»&lt;br&gt;OrderStatus" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="860" width="280" height="140" as="geometry"/></mxCell><mxCell id="classes-v36" value="Pending = 0 · Pendente&lt;br&gt;Confirmed = 1 · Confirmado&lt;br&gt;Shipped = 2 · Enviado&lt;br&gt;Delivered = 3 · Entregue&lt;br&gt;Canceled = 4 · Cancelado&lt;br&gt;AwaitingPayment = 5 · Aguardando pagamento" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="classes-cls35"><mxGeometry x="0" y="44" width="280" height="96" as="geometry"/></mxCell><mxCell id="classes-cls37" value="«enumeração»&lt;br&gt;SubscriptionStatus" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1300" y="1040" width="280" height="126" as="geometry"/></mxCell><mxCell id="classes-v38" value="Trial = 0 · teste (reservado)&lt;br&gt;Active = 1 · em dia&lt;br&gt;PastDue = 2 · atrasada (tolerância)&lt;br&gt;Suspended = 3 · suspensa (vale o Grátis)&lt;br&gt;Canceled = 4 · cancelada" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="classes-cls37"><mxGeometry x="0" y="44" width="280" height="82" as="geometry"/></mxCell><mxCell id="classes-cls39" value="«enumeração»&lt;br&gt;PlanAction" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1700" y="430" width="300" height="140" as="geometry"/></mxCell><mxCell id="classes-v40" value="Current = 0 · plano atual&lt;br&gt;Checkout = 1 · assinar / upgrade&lt;br&gt;ScheduleDowngrade = 2 · plano menor&lt;br&gt;KeepCurrent = 3 · desistir do downgrade&lt;br&gt;CancelToFree = 4 · cancelar&lt;br&gt;Unavailable = 5 · indisponível agora" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="classes-cls39"><mxGeometry x="0" y="44" width="300" height="96" as="geometry"/></mxCell><mxCell id="classes-cls41" value="«enumeração»&lt;br&gt;CloudinaryCleanupMode" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1700" y="640" width="300" height="98" as="geometry"/></mxCell><mxCell id="classes-v42" value="Off · não roda&lt;br&gt;DryRun · só registra no log&lt;br&gt;Delete · apaga de verdade" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="classes-cls41"><mxGeometry x="0" y="44" width="300" height="54" as="geometry"/></mxCell><mxCell id="classes-cls43" value="«enumeração»&lt;br&gt;OrderPaymentMethod" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1700" y="780" width="300" height="84" as="geometry"/></mxCell><mxCell id="classes-v44" value="Arrange = 0 · combinar com a loja&lt;br&gt;Online = 1 · Mercado Pago" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="classes-cls43"><mxGeometry x="0" y="44" width="300" height="40" as="geometry"/></mxCell><mxCell id="classes-cls45" value="«enumeração»&lt;br&gt;OrderPaymentStatus" style="swimlane;fontStyle=1;align=center;verticalAlign=middle;childLayout=stackLayout;horizontal=1;startSize=44;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;html=1;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1700" y="900" width="300" height="126" as="geometry"/></mxCell><mxCell id="classes-v46" value="None = 0 · sem pagamento online&lt;br&gt;Pending = 1 · esperando pagar&lt;br&gt;Approved = 2 · pago&lt;br&gt;Refunded = 3 · estornado&lt;br&gt;Canceled = 4 · não pago (prazo ou cancelado)" style="text;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;spacingRight=6;spacingTop=3;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;html=1;whiteSpace=nowrap;fontSize=11;" vertex="1" parent="classes-cls45"><mxGeometry x="0" y="44" width="300" height="82" as="geometry"/></mxCell><mxCell id="classes-v47" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; chave primária · &lt;b&gt;FK&lt;/b&gt; chave estrangeira&lt;br&gt;&lt;i&gt;{único}&lt;/i&gt; índice único · &lt;b&gt;tipo?&lt;/b&gt; pode ser nulo&lt;br&gt;&lt;b&gt;1&lt;/b&gt;, &lt;b&gt;0..1&lt;/b&gt;, &lt;b&gt;*&lt;/b&gt;, &lt;b&gt;1..*&lt;/b&gt; multiplicidade&lt;br&gt;◆ composição: as partes são apagadas junto&lt;br&gt;- - - ligação lógica, sem FK no banco&lt;br&gt;&lt;br&gt;&lt;b&gt;Cores&lt;/b&gt;&lt;br&gt;verde: usuários e acesso&lt;br&gt;azul: lojas e catálogo&lt;br&gt;laranja: pedidos&lt;br&gt;roxo: assinaturas e pagamentos&lt;br&gt;cinza: enums&lt;br&gt;&lt;br&gt;&lt;b&gt;Exclusão lógica&lt;/b&gt;: User, Store, Category e Product&lt;br&gt;têm DeletionDate e não são apagados de verdade.&lt;br&gt;Os únicos de Store (nome, CNPJ), Category e Product&lt;br&gt;valem só para quem não foi excluído." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#bbbbbb;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1700" y="100" width="300" height="310" as="geometry"/></mxCell><mxCell id="classes-v48" value="&lt;b&gt;ColorGroupId&lt;/b&gt; agrupa o mesmo modelo em cores diferentes (cada cor é um Product). Não é FK." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="40" y="1040" width="270" height="64" as="geometry"/></mxCell><mxCell id="classes-v49" value="&lt;b&gt;OrderItem&lt;/b&gt; copia nome, preço e foto do produto no momento do pedido: o histórico não muda se o produto mudar ou for excluído." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1120" y="1150" width="170" height="120" as="geometry"/></mxCell><mxCell id="classes-e50" value="" style="edgeStyle=orthogonalEdgeStyle;jumpStyle=arc;jumpSize=10;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#555555;fontColor=#333333;startArrow=none;endArrow=none;exitX=0;exitY=0.33;exitDx=0;exitDy=0;entryX=1;entryY=0.55;entryDx=0;entryDy=0;" edge="1" parent="1" source="classes-cls9" target="classes-cls3"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="370" y="160"/><mxPoint x="370" y="177"/></Array></mxGeometry></mxCell><mxCell id="classes-l51" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#333333;" vertex="1" connectable="0" parent="classes-e50"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="classes-l52" value="*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;fontColor=#333333;" vertex="1" connectable="0" parent="classes-e50"><mxGeometry x="