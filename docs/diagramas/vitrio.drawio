=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc-vitrine-v10" target="uc-vitrine-v29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc-vitrine-e33" value="«extend»&lt;br&gt;[cliente logado]" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc-vitrine-v30" target="uc-vitrine-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc-vitrine-e34" value="«include»" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc-vitrine-v14" target="uc-vitrine-v31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc-vitrine-v35" value="«sistema externo»&lt;br&gt;&lt;b&gt;Resend (e-mail)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="674" width="170" height="64" as="geometry"/></mxCell><mxCell id="uc-vitrine-e36" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#777777;" edge="1" parent="1" source="uc-vitrine-v31" target="uc-vitrine-v35"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc-vitrine-v37" value="Pagar online&lt;br&gt;(Pix ou cartão)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="725" y="578" width="210" height="52" as="geometry"/></mxCell><mxCell id="uc-vitrine-e38" value="«extend»&lt;br&gt;[loja aceita]" style="endArrow=open;endSize=10;dashed=1;html=1;rounded=0;strokeColor=#555555;fontSize=10;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="uc-vitrine-v37" target="uc-vitrine-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc-vitrine-v39" value="«sistema externo»&lt;br&gt;&lt;b&gt;Mercado Pago&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="572" width="170" height="64" as="geometry"/></mxCell><mxCell id="uc-vitrine-e40" value="" style="endArrow=none;html=1;rounded=0;strokeColor=#777777;" edge="1" parent="1" source="uc-vitrine-v37" target="uc-vitrine-v39"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="uc-vitrine-v41" value="&lt;b&gt;Pagar depois ou cancelar&lt;/b&gt;: quem foi pagar no Mercado Pago e voltou sem pagar vê o pedido na vitrine. Cancelado (ou vencido), os itens voltam para o carrinho." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1090" y="800" width="260" height="96" as="geometry"/></mxCell><mxCell id="uc-vitrine-v42" value="&lt;b&gt;Fazer pedido&lt;/b&gt;: sem conta, o cliente informa nome, telefone e endereço. Com conta, pode usar um endereço salvo e o pedido aparece em “Meus pedidos”.&lt;br&gt;&lt;br&gt;O preço vem sempre do banco e o estoque é baixado na hora (ver “Fluxo — Compra na vitrine”)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1090" y="330" width="260" height="150" as="geometry"/></mxCell><mxCell id="uc-vitrine-v43" value="&lt;b&gt;Cliente&lt;/b&gt; é um visitante que entrou na conta: faz tudo o que o visitante faz, e mais." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="60" y="1000" width="160" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram