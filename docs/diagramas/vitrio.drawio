verticalAlign=middle;fontSize=13;whiteSpace=wrap;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="50" width="1400" height="24" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v3" value="Cliente (navegador)" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="100" width="1920" height="240" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v4" value="Vitrio (API)" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="1920" height="540" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v5" value="Mercado Pago (conta da loja)" style="swimlane;horizontal=0;startSize=40;html=1;whiteSpace=wrap;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;swimlaneFillColor=#ffffff;collapsible=0;" vertex="1" parent="1"><mxGeometry x="20" y="880" width="1920" height="200" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v6" value="Escolhe “Pagar agora”&lt;br&gt;no checkout" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v3"><mxGeometry x="55" y="92" width="190" height="56" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v7" value="A loja aceita?&lt;br&gt;(plano e conta&lt;br&gt;conectada)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-pagamento-pedido-v4"><mxGeometry x="65" y="65" width="170" height="110" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v8" value="Recusa: escolher&lt;br&gt;“combinar com a loja”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v4"><mxGeometry x="55" y="270" width="190" height="60" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v9" value="Prazo vencido sem pagar:&lt;br&gt;cancela e devolve o estoque" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v4"><mxGeometry x="35" y="440" width="230" height="60" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v10" value="Reserva o estoque e cria o pedido&lt;br&gt;&lt;b&gt;Aguardando pagamento&lt;/b&gt;&lt;br&gt;(60 min; pagar até 30 min antes)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v4"><mxGeometry x="310" y="82" width="240" height="76" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v11" value="Cria a cobrança (preferência)&lt;br&gt;com o token da loja:&lt;br&gt;Pix ou cartão" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v5"><mxGeometry x="315" y="62" width="230" height="76" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v12" value="Paga no checkout&lt;br&gt;do Mercado Pago" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v3"><mxGeometry x="640" y="90" width="200" height="60" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v13" value="Aprova o pagamento&lt;br&gt;(o dinheiro vai para a loja)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v5"><mxGeometry x="630" y="68" width="220" height="64" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v14" value="Confere: aviso do Mercado Pago,&lt;br&gt;volta do cliente (?pedido=) ou&lt;br&gt;manutenção a cada 1 min" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v4"><mxGeometry x="910" y="382" width="260" height="76" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v15" value="Aprovado, com a&lt;br&gt;referência e o valor&lt;br&gt;do pedido?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-pagamento-pedido-v4"><mxGeometry x="945" y="120" width="190" height="120" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v16" value="Ainda “Aguardando&lt;br&gt;pagamento”?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="f-pagamento-pedido-v4"><mxGeometry x="1270" y="130" width="180" height="100" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v17" value="Vira &lt;b&gt;Pendente&lt;/b&gt;: o lojista recebe&lt;br&gt;o aviso (painel e e-mail)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v4"><mxGeometry x="1560" y="147" width="240" height="66" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v18" value="Vê “Pagamento aprovado”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v3"><mxGeometry x="1570" y="92" width="220" height="56" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v19" value="Já cancelado: estorna&lt;br&gt;o pagamento sozinho" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v4"><mxGeometry x="1255" y="370" width="210" height="60" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-pagamento-pedido-v6" target="f-pagamento-pedido-v7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e21" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-pagamento-pedido-v7" target="f-pagamento-pedido-v8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e22" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-pagamento-pedido-v7" target="f-pagamento-pedido-v10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e23" value="cria a cobrança" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pagamento-pedido-v10" target="f-pagamento-pedido-v11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e24" value="link do checkout" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pagamento-pedido-v11" target="f-pagamento-pedido-v12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="605" y="980"/><mxPoint x="605" y="220"/></Array></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pagamento-pedido-v12" target="f-pagamento-pedido-v13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e26" value="avisa" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pagamento-pedido-v13" target="f-pagamento-pedido-v14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="980"/></Array></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pagamento-pedido-v14" target="f-pagamento-pedido-v15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e28" value="Não (espera)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pagamento-pedido-v15" target="f-pagamento-pedido-v14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="900" y="520"/><mxPoint x="900" y="760"/></Array></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e29" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-pagamento-pedido-v15" target="f-pagamento-pedido-v16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e30" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-pagamento-pedido-v16" target="f-pagamento-pedido-v17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e31" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pagamento-pedido-v16" target="f-pagamento-pedido-v19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pagamento-pedido-v17" target="f-pagamento-pedido-v18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-v33" value="Volta sem pagar: a vitrine&lt;br&gt;oferece “Pagar agora” ou&lt;br&gt;“Cancelar pedido”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v3"><mxGeometry x="925" y="82" width="230" height="76" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v34" value="Confere no Mercado Pago e cancela:&lt;br&gt;o estoque volta e os itens&lt;br&gt;voltam para o carrinho" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="f-pagamento-pedido-v4"><mxGeometry x="1230" y="12" width="260" height="76" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-e35" value="volta sem&lt;br&gt;pagar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-pagamento-pedido-v12" target="f-pagamento-pedido-v33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e36" value="pagar agora" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pagamento-pedido-v33" target="f-pagamento-pedido-v12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1060" y="135"/><mxPoint x="760" y="135"/></Array></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e37" value="cancelar" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-pagamento-pedido-v33" target="f-pagamento-pedido-v34"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1380" y="220"/></Array></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-e38" value="sem pagamento no prazo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="f-pagamento-pedido-v10" target="f-pagamento-pedido-v9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="414" y="810"/></Array></mxGeometry></mxCell><mxCell id="f-pagamento-pedido-v39" value="Nenhum aviso é confiável sozinho: o pagamento é sempre lido na API do Mercado Pago com o token da loja, e as mudanças de status são condicionais (“só se ainda Aguardando pagamento”)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1560" y="640" width="330" height="90" as="geometry"/></mxCell><mxCell id="f-pagamento-pedido-v40" value="&lt;b&gt;Cancelar&lt;/b&gt; um pedido já pago estorna o valor no Mercado Pago. Um segundo pagamento do mesmo pedido também é estornado." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="1560" y="750" width="330" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
