id="f-assinatura-e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-assinatura-v21" target="f-assinatura-v22"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-e43" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-assinatura-v20" target="f-assinatura-v23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-e44" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-assinatura-v23" target="f-assinatura-v24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-e45" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-assinatura-v23" target="f-assinatura-v25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-v46" value="&lt;b&gt;Quem confere o status&lt;/b&gt;:&lt;br&gt;• o webhook do Mercado Pago&lt;br&gt;• a página de assinatura (/sync)&lt;br&gt;• a manutenção, a cada 1 min, para os checkouts abertos nas últimas 2h&lt;br&gt;Sempre consulta a API do Mercado Pago: nunca confia só no aviso. Assinatura x-signature inválida: responde 401." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="2080" y="790" width="330" height="110" as="geometry"/></mxCell><mxCell id="f-assinatura-v47" value="&lt;b&gt;DecideAction&lt;/b&gt; é a mesma regra que monta os botões da página: o backend nunca faz algo que o botão não oferecia." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fffbe6;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=10;" vertex="1" parent="1"><mxGeometry x="300" y="760" width="250" height="80" as="geometry"/></mxCell><mxCell id="f-assinatura-v48" value="&lt;b&gt;Depois de ativa: renovação e atraso&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="1180" width="600" height="28" as="geometry"/></mxCell><mxCell id="f-assinatura-v49" value="O Mercado Pago cobra&lt;br&gt;todo mês" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="1260" width="200" height="60" as="geometry"/></mxCell><mxCell id="f-assinatura-v50" value="Cobrança&lt;br&gt;aprovada?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="365" y="1245" width="150" height="90" as="geometry"/></mxCell><mxCell id="f-assinatura-v51" value="Avança o fim do período e aplica&lt;br&gt;o plano menor agendado, se houver" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="1257" width="260" height="66" as="geometry"/></mxCell><mxCell id="f-assinatura-v52" value="Fica atrasada (PastDue):&lt;br&gt;o plano continua por 7 dias" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="325" y="1420" width="230" height="60" as="geometry"/></mxCell><mxCell id="f-assinatura-v53" value="Pagou dentro&lt;br&gt;dos 7 dias?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" vertex="1" parent="1"><mxGeometry x="680" y="1400" width="160" height="100" as="geometry"/></mxCell><mxCell id="f-assinatura-v54" value="Suspensa: volta a valer o Grátis&lt;br&gt;(lojas e produtos além do limite&lt;br&gt;saem da vitrine)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="950" y="1412" width="260" height="76" as="geometry"/></mxCell><mxCell id="f-assinatura-e55" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-assinatura-v49" target="f-assinatura-v50"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-e56" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-assinatura-v50" target="f-assinatura-v51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-e57" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-assinatura-v50" target="f-assinatura-v52"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-e58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-assinatura-v52" target="f-assinatura-v53"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-e59" value="Sim" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="f-assinatura-v53" target="f-assinatura-v51"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-e60" value="Não" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;fontSize=11;strokeColor=#444444;labelBackgroundColor=#ffffff;fontColor=#222222;" edge="1" parent="1" source="f-assinatura-v53" target="f-assinatura-v54"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-assinatura-v61" value="&lt;b&gt;Cancelamento&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1400" y="1180" width="400" height="28" as="geometry"/></mxCell><mxCell id="f-assinatura-v62" value="Clica em&lt;br&gt;“Cancelar assinatura”" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1400" y="1260" width="200" height="60" as="geometry"/></mxCell><mxCell id="f-assinatura-v63" value="Cancela a assinatura&lt;br&gt;no Mercado Pago" style="rounded=1;whiteSpace=wrap;html=1;arcSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1660" y="1260" width="200" height="60" as="geometry"/></mxCell><mxCell id="f-assinatura-v64" value="O plano pago vale até o fim&lt;br&gt;do período; depois, Grátis" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=12;" verte