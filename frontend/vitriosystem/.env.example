# Copie para .env.local (desenvolvimento) ou cadastre na hospedagem (produção).
# NEXT_PUBLIC_API_URL é obrigatória no build de produção: ela vai junto no código do navegador,
# então mudar depois exige um build novo.

# Endereço da API visto pelo navegador
NEXT_PUBLIC_API_URL=http://localhost:5020

# Endereço da API visto pelo servidor do Next (upload de imagens e prévia do link das lojas).
# Vazio = o de cima.
API_URL=http://localhost:5020

# Cloudinary: o upload das imagens é feito pelo servidor do Next (app/api/upload)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Pasta das imagens. Precisa ser igual a Cloudinary:Folder no backend, e cada ambiente precisa da
# sua (ex.: vitrio-dev e vitrio-prod), senão a limpeza de um apaga as imagens do outro.
CLOUDINARY_FOLDER=vitrio

# E-mail de suporte mostrado no rodapé e na tela de Suporte (fixado no build). Vazio = não mostra.
NEXT_PUBLIC_SUPPORT_EMAIL=

# Endereço público do site, usado na imagem de prévia do link da loja (WhatsApp, Instagram).
# Vazio = o endereço pelo qual a página foi pedida, que serve na maioria das hospedagens.
SITE_URL=
